# ---------------------------------------------------------------------------
# Fixture mode needs NONE of these. `pnpm demo` runs fully offline.
# Only fill these in for `pnpm dev --live`.
# ---------------------------------------------------------------------------

# Google Cloud — required for live mode (Gemini via Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Grafana — metrics push (partner track)
# Apron pushes Prometheus-format metrics to this endpoint.
GRAFANA_ENDPOINT=http://localhost:3100
GRAFANA_API_KEY=
GRAFANA_ORG_ID=

# Clickhouse — append-only audit log (partner track)
# When set, every agent event is written to an audit_log table.
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=apron

# Firebase — auth + Firestore persistence
# Server-side: uses GOOGLE_APPLICATION_CREDENTIALS or default credentials on Cloud Run.
# Set FIREBASE_SERVICE_ACCOUNT to override with a specific service account key.
FIREBASE_SERVICE_ACCOUNT=
# Client-side: served to the board UI for Firebase Auth (Google sign-in).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=apron-dev-504523.firebaseapp.com
FIREBASE_PROJECT_ID=apron-dev-504523

# Data sources
GAME_FEED_API_KEY=
WEATHER_API_KEY=
# AviationStack flight status API — TRAFFIC agent uses this for live flight monitoring.
# Free tier: 100 calls/month (HTTP only). Get a key at https://aviationstack.com
# SECURITY: Never commit the actual key. This project will be open-sourced.
FLIGHT_STATUS_API_KEY=

# Twilio — SMS outreach for WRANGLER agent
# Get credentials from https://console.twilio.com
# SECURITY: Never commit actual values. This project will be open-sourced.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# TMC adapter — mock adapter needs nothing
TMC_ADAPTER=mock
TMC_API_BASE=
TMC_API_KEY=

# Rule packs — sample pack is bundled and needs no configuration
RULE_PACK=sample-local

# Runtime
PORT=3000
LOG_LEVEL=info
