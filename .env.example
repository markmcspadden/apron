# ---------------------------------------------------------------------------
# Fixture mode needs NONE of these. `pnpm demo` runs fully offline.
# Only fill these in for `pnpm dev --live`.
# ---------------------------------------------------------------------------

# Google Cloud — required for live mode (Gemini via Agent Builder)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Partner track — TODO: fill in once the track is chosen
# (IBM | Grafana | Parallel | Clickhouse | Replit)
PARTNER_API_KEY=
PARTNER_ENDPOINT=

# Data sources
GAME_FEED_API_KEY=
WEATHER_API_KEY=
FLIGHT_STATUS_API_KEY=

# TMC adapter — mock adapter needs nothing
TMC_ADAPTER=mock
TMC_API_BASE=
TMC_API_KEY=

# Rule packs — sample pack is bundled and needs no configuration
RULE_PACK=sample-local

# Runtime
PORT=3000
LOG_LEVEL=info
