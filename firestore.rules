rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts — authenticated users can read; server (Admin SDK) writes
    match /accounts/{accountId} {
      allow read: if request.auth != null;
      allow write: if false; // server-side only via Admin SDK

      // Entities (TMC desk, production coordination)
      match /entities/{entityId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Members (people with login access)
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Crew (production crew assigned to games)
      match /crew/{crewId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Games
      match /games/{gameId} {
        allow read: if request.auth != null;
        allow write: if false;

        // Assignments (crew assigned to a game)
        match /assignments/{assignmentId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }

    // Audit events — authenticated users can read; server writes
    match /audit_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User profiles — users can read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
